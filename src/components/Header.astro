---
import { site, phoneHref } from '../lib/content.js';

// Main menu — add, remove or reorder links here
const nav = [
  { label: 'Home', href: '/' },
  { label: 'About us', href: '/about-us/' },
  { label: 'Services', href: '/services/' },
  { label: 'Gallery', href: '/gallery/' },
  { label: 'Testimonials', href: '/testimonials/' },
  { label: 'Contact', href: '/contact/' },
];
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="logo" aria-label={site.name + ' home'}>
      <img src="/images/Phillips_Concrete_pty_ltd_logo.png" alt={site.legalName} width="190" height="52" />
    </a>
    <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-label="Open menu" />
    <label for="menu-toggle" class="burger" aria-hidden="true"><span></span><span></span><span></span></label>
    <nav>
      {nav.map((item) => (
        <a href={item.href} class={current === item.href ? 'active' : ''}>{item.label}</a>
      ))}
      <a href={phoneHref} class="call">{site.phone}</a>
    </nav>
  </div>
</header>

<style>
  .site-header { background: var(--ink); position: sticky; top: 0; z-index: 50; }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 84px; }
  .logo img { height: 52px; width: auto; }
  nav { display: flex; align-items: center; gap: 28px; }
  nav a { color: #e8e8e8; text-decoration: none; font-size: .95rem; font-weight: 500; padding: 6px 0; border-bottom: 2px solid transparent; }
  nav a:hover, nav a.active { color: var(--brand); border-color: var(--brand); }
  nav a.call { background: var(--brand); color: var(--ink); font-weight: 700; padding: 10px 16px; border-radius: var(--radius); border: 0; }
  nav a.call:hover { background: var(--brand-dark); color: var(--ink); }
  .menu-toggle, .burger { display: none; }
  @media (max-width: 900px) {
    .burger { display: flex; flex-direction: column; gap: 5px; cursor: pointer; padding: 10px; }
    .burger span { width: 26px; height: 3px; background: #fff; border-radius: 2px; }
    nav { display: none; position: absolute; top: 84px; left: 0; right: 0; background: var(--ink); flex-direction: column; align-items: stretch; gap: 0; padding: 8px 24px 24px; }
    nav a { padding: 14px 0; border-bottom: 1px solid #2a2a2a; }
    nav a.call { margin-top: 16px; text-align: center; }
    .menu-toggle:checked ~ nav { display: flex; }
  }
</style>

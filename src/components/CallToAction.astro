---
import { site, phoneHref } from '../lib/content.js';
---
<section class="cta">
  <div class="wrap inner">
    <div>
      <h2>Talk to us today about how we can help you</h2>
      <p>We've been helping clients across {site.serviceArea} with their concrete construction needs for more than {site.yearsExperience} years, and we look forward to working with you.</p>
    </div>
    <div class="btns">
      <a class="btn" href={phoneHref}>Call {site.contactName} · {site.phone}</a>
      <a class="btn ghost" href="/contact/">Request a quote</a>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--ink); color: #ccc; }
  .inner { display: grid; grid-template-columns: 1.5fr 1fr; gap: 40px; align-items: center; }
  h2 { color: #fff; }
  p { margin: 0; max-width: 600px; }
  .btns { display: flex; flex-direction: column; gap: 12px; }
  .btn { text-align: center; }
  @media (max-width: 800px) { .inner { grid-template-columns: 1fr; } }
</style>

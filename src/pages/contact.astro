---
import Base from '../layouts/Base.astro';
import { site, phoneHref } from '../lib/content.js';
---
<Base title="Contact">
  <div class="page-head"><div class="wrap"><h1>Contact</h1><p>Please contact {site.contactName} today for a quote.</p></div></div>
  <section>
    <div class="wrap split">
      <div>
        <h2>Get in touch</h2>
        <p class="big"><a href={phoneHref}>{site.phone}</a></p>
        <p class="big"><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p>Servicing {site.serviceArea}.</p>
        <p><a href={site.facebook} rel="noopener">Facebook</a> · <a href={site.instagram} rel="noopener">Instagram</a></p>
      </div>
      <form action={site.contactForm.action} method="POST">
        <input type="hidden" name="access_key" value={site.contactForm.accessKey} />
        <input type="hidden" name="subject" value={`New enquiry from ${site.name} website`} />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />
        <label>Your name *<input name="name" required /></label>
        <label>Your email *<input type="email" name="email" required /></label>
        <label>Phone<input type="tel" name="phone" /></label>
        <label>Suburb<input name="suburb" /></label>
        <label>Your message *<textarea name="message" rows="6" required></textarea></label>
        <button class="btn" type="submit">Send enquiry</button>
      </form>
    </div>
  </section>
</Base>
<style>
  .split { display: grid; grid-template-columns: 1fr 1.2fr; gap: 56px; }
  .big { font-size: 1.35rem; font-weight: 700; margin: 0 0 .4em; }
  .big a { text-decoration: none; color: var(--ink); }
  .big a:hover { color: var(--brand-dark); }
  form { background: var(--bg-alt); padding: 32px; border-radius: var(--radius); display: grid; gap: 16px; }
  label { display: grid; gap: 6px; font-weight: 600; font-size: .92rem; }
  input, textarea { font: inherit; padding: 12px 14px; border: 1px solid #d4d4d0; border-radius: var(--radius); background: #fff; }
  input:focus, textarea:focus { outline: 2px solid var(--brand); border-color: transparent; }
  .hp { display: none; }
  button { justify-self: start; }
  @media (max-width: 800px) { .split { grid-template-columns: 1fr; } }
</style>
